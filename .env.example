# ---- Retrieval: Moss (https://www.moss.dev , docs.moss.dev) ----
# When these are set, retrieval uses Moss. When blank, the app falls back to
# local BM25 so it still runs. Verify exact names against docs.moss.dev.
MOSS_PROJECT_ID=your-moss-project-id
MOSS_PROJECT_KEY=your-moss-project-key
MOSS_INDEX=disputes

# ---- LLM: TrueFoundry AI Gateway (OpenAI-compatible) ----
# When these are set, intent + guidance + PII redaction run through TrueFoundry.
# When blank, the app uses local fallbacks. Get the gateway base URL + key from
# your TrueFoundry console.
TRUEFOUNDRY_BASE_URL=https://gateway.truefoundry.ai
TRUEFOUNDRY_API_KEY=your-truefoundry-api-key
TRUEFOUNDRY_MODEL=openai-main/gpt-4o-mini

# ---- Ingestion: Unsiloed (https://docs.unsiloed.ai) ----
# Build-time only. Used by `npm run ingest-pdf` to turn source PDFs into chunks.
# Not used by the running server. Verify endpoint + auth at docs.unsiloed.ai.
UNSILOED_API_KEY=your-unsiloed-api-key
UNSILOED_BASE_URL=https://prod.visionapi.unsiloed.ai/
UNSILOED_STRATEGY=semantic

# ---- Server ----
PORT=3000
